# Database
DATABASE_URL="mysql://root:@localhost:3306/techflare"

# Auth (REQUIRED in production — app will fail to start without these)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Optional AI
OPENAI_API_KEY=""
AI_SERVICE_URL="http://localhost:8000"

# Public URLs (REQUIRED in production — set before npm run build)
NEXT_PUBLIC_APP_URL="https://www.techflare-solutions.com"
NEXT_PUBLIC_COMPANY_EMAIL="solutionstechflare@gmail.com"
NEXT_PUBLIC_SOLUTIONS_EMAIL="solutionstechflare@gmail.com"
NEXT_PUBLIC_COMPANY_PHONE="+254 769227291"
NEXT_PUBLIC_WHATSAPP="254769227291"
NEXT_PUBLIC_ADMIN_PANEL_URL="http://localhost:3001"

# Admin panel API (REQUIRED in production — must match admin-panel/.env)
ADMIN_API_KEY="change-this-admin-api-key-in-production"

# Seed (development only — never set in production unless intentional)
# SEED_DEMO_DATA="true"
